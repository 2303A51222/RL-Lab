        "n = int(input(\"Enter number of machines: \"))\n",
        "names = []\n",
        "rewards_list = []\n",
        "Q = []\n",
        "N = []\n",
        "for i in range(n):\n",
        "    name = input(\"Enter machine name: \")\n",
        "    rewards = list(map(int, input(\"Enter rewards: \").split()))\n",
        "    names.append(name)\n",
        "    rewards_list.append(rewards)\n",
        "    Q.append(0)\n",
        "    N.append(0)\n",
        "for i in range(n):\n",
        "    print(\"\\nMachine\", names[i])\n",
        "    for reward in rewards_list[i]:\n",
        "        N[i] = N[i] + 1\n",
        "        Q[i] = Q[i] + (reward - Q[i]) / N[i]\n",
        "        print(\"Reward =\", reward)\n",
        "        print(\"N =\", N[i])\n",
        "        print(\"Q =\", round(Q[i], 2))\n",
        "for i in range(n):\n",
        "    print(\"Machine\", names[i])\n",
        "    print(\"Rewards:\", rewards_list[i])\n",
        "    print(\"N =\", N[i])\n",
        "    print(\"Q =\", round(Q[i], 2))\n",
        "highest = 0\n",
        "for i in range(1, n):\n",
        "    if Q[i] > Q[highest]:\n",
        "        highest = i\n",
        "\n",
        "print(\"\\nGreedy Selected Machine:\", names[highest])"

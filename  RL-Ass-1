      "source": [
        "n = int(input(\"Enter number of machines: \"))\n",
        "names = []\n",
        "q_values = []\n",
        "for i in range(n):\n",
        "    name = input(\"Enter machine name: \")\n",
        "    rewards = list(map(int, input(\"Enter rewards: \").split()))\n",
        "    total = 0\n",
        "    for reward in rewards:\n",
        "        total = total + reward\n",
        "    q = total / len(rewards)\n",
        "    names.append(name)\n",
        "    q_values.append(q)\n",
        "for i in range(n):\n",
        "    print(\"Machine\", names[i])\n",
        "    print(\"Q(\" + names[i] + \") =\", round(q_values[i], 2))\n",
        "highest = 0\n",
        "for i in range(1, n):\n",
        "    if q_values[i] > q_values[highest]:\n",
        "        highest = i\n",
        "print(\"\\nGreedy Selected Machine:\", names[highest])"
